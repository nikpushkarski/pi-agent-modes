{
  "name": "@nikpushkarski/pi-agent-modes",
  "version": "0.2.1",
  "description": "Set up a low-usage Default mode and a Beast mode for longer work in each Pi project.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikpushkarski/pi-agent-modes.git"
  },
  "homepage": "https://github.com/nikpushkarski/pi-agent-modes#readme",
  "bugs": {
    "url": "https://github.com/nikpushkarski/pi-agent-modes/issues"
  },
  "keywords": ["pi-package", "pi-extension", "agent-modes", "ralph-loop"],
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } },
  "files": ["src/", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test:smoke": "node scripts/smoke.js",
    "test": "node --test test/*.test.js",
    "test:release": "node --test scripts/release.test.js",
    "release": "semantic-release"
  },
  "pi": { "extensions": ["./src/index.ts"] },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  }
}
